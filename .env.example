# ---------------------------------------------------------------------------
# Hasura — composition des portefeuilles modèles (base Value Investing Screener)
# ---------------------------------------------------------------------------
HASURA_ENDPOINT=
HASURA_ADMIN_SECRET=
# Compte propriétaire des trois portefeuilles modèles dans Hasura
PLT_PORTFOLIO_OWNER_EMAIL=seminaireplt@gmail.com

# ---------------------------------------------------------------------------
# EODHD — cours des lignes hors référentiel (ETF obligataires)
# ---------------------------------------------------------------------------
EODHD_API_TOKEN=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Origine utilisée dans les liens envoyés par e-mail (invitation, réinit.).
# En production : l'URL publique du site, sinon les invitations pointent en local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — accès, contenu éditorial et stockage des documents
# Project Settings → API. Tant que ces variables sont vides, l'authentification
# est désactivée en développement et l'application renvoie 503 en production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé `service_role` — secrète, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
